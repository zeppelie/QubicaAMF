# Copy this file to .env and fill it in before running docker compose.

# SQL Server only starts once you accept its licence: set this to Y.
# https://go.microsoft.com/fwlink/?linkid=857698
ACCEPT_EULA=N

# At least 8 characters with upper case, lower case, digits and symbols.
MSSQL_SA_PASSWORD=

# Signs the access tokens, at least 32 characters.
JWT_KEY=

# Password of the "admin" user of Jenkins, only needed with the "ci" profile.
JENKINS_ADMIN_PASSWORD=
