{
  "Jwt": {
    "Issuer": "cinema-identity",
    "Audience": "cinema-services"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "logs/.log", "rollingInterval": "Day" } }
    ]
  },
  "AllowedHosts": "*"
}
