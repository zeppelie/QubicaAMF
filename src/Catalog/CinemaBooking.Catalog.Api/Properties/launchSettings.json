{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "Docker Compose (up)": {
      "commandName": "Executable",
      "executablePath": "cmd.exe",
      "commandLineArgs": "/k docker compose up --build -d && start http://localhost:5101/scalar && docker compose logs -f",
      "workingDirectory": "$(ProjectDir)..\\..\\.."
    },
    "Docker Compose (down)": {
      "commandName": "Executable",
      "executablePath": "cmd.exe",
      "commandLineArgs": "/k docker compose down",
      "workingDirectory": "$(ProjectDir)..\\..\\.."
    },
    "https": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "launchUrl": "scalar",
      "applicationUrl": "https://localhost:7101;http://localhost:5101",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    "http": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "launchUrl": "scalar",
      "applicationUrl": "http://localhost:5101",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    }
  }
}
